    <string name="status_app_registered_error_desc"><![CDATA[可能是应用进行了反向注册，或者注册信息与推送服务不匹配。另见 <b><a href="https://github.com/MiPushFramework/MiPushFramework/wiki/%5B%E5%B8%AE%E5%8A%A9%5D-%E6%B3%A8%E5%86%8C%E5%BC%82%E5%B8%B8">[帮助] 注册异常</a></b>。]]></string>
