<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/focus_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/notification_focus_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/focus_stage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/notification_focus_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/focus_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/notification_focus_secondary"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/focus_timeline"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="2dp">

        <ProgressBar
            android:id="@+id/focus_progress_track"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="top"
            android:layout_marginStart="28dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="28dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/notification_focus_track" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/focus_dot_merchant"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:contentDescription="@string/notification_focus_stage_merchant"
                android:scaleType="centerInside"
                android:src="@drawable/notification_focus_point_inactive" />

            <ImageView
                android:id="@+id/focus_dot_courier"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:contentDescription="@string/notification_focus_stage_courier"
                android:scaleType="centerInside"
                android:src="@drawable/notification_focus_point_inactive" />

            <ImageView
                android:id="@+id/focus_dot_delivered"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:contentDescription="@string/notification_focus_stage_delivered"
                android:scaleType="centerInside"
                android:src="@drawable/notification_focus_point_inactive" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/focus_label_merchant"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/notification_focus_stage_merchant"
                android:textColor="@color/notification_focus_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/focus_label_courier"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/notification_focus_stage_courier"
                android:textColor="@color/notification_focus_secondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/focus_label_delivered"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/notification_focus_stage_delivered"
                android:textColor="@color/notification_focus_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
